<?xml version="1.0" encoding="utf-8"?>
<!--
  Keep in sync with AppBlockerService.kt:
  - typeWindowStateChanged     -> app blocking (foreground app changed)
  - typeWindowContentChanged   -> web filter (address bar text changed while browsing)
  - canRetrieveWindowContent   -> required for rootInActiveWindow; false makes the web filter a no-op
  - flagReportViewIds          -> required for findAccessibilityNodeInfosByViewId (address bar lookup)
-->
<accessibility-service xmlns:android="http://schemas.android.com/apk/res/android"
    android:accessibilityEventTypes="typeWindowStateChanged|typeWindowContentChanged"
    android:accessibilityFeedbackType="feedbackGeneric"
    android:accessibilityFlags="flagDefault|flagReportViewIds"
    android:canRetrieveWindowContent="true"
    android:description="@string/accessibility_service_description"
    android:notificationTimeout="100" />
